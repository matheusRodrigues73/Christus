{
  "name": "christus",
  "version": "1.0.0",
  "description": "Plataform to unify the body of Christus",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && npx next",
    "test": "npm run services:up && concurrently --names next,jest --hide next -k --success command-jest \"next\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watch --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint . --max-warnings 0",
    "lint:secretlint:check": "secretlint \"**/*\"",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations  --envPath .env.development --dry-run up",
    "commit": "cz",
    "prepare": "husky"
  },
  "author": "matheusRodrigues73",
  "license": "MIT",
  "dependencies": {
    "@primer/primitives": "11.9.0",
    "@primer/react": "38.32.0",
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "cookie": "2.0.1",
    "next": "16.3.1",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.6.1",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "2.5.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/css": "1.0.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@eslint/json": "1.1.0",
    "@eslint/markdown": "7.5.1",
    "@faker-js/faker": "9.7.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "commitizen": "4.3.2",
    "concurrently": "10.0.4",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "17.4.2",
    "dotenv-expand": "1000.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.1",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "secretlint": "13.0.4",
    "set-cookie-parser": "3.1.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
